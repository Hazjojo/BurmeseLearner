{
  "name": "burmeselearner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run validate && tsc -b && vite build",
    "preview": "vite preview",
    "validate": "node scripts/validate-content.mjs",
    "test": "vitest run --dir src",
    "icons": "node scripts/make-icons.mjs",
    "test:sync": "npx -y firebase-tools@15.37.0 emulators:exec --only auth,firestore,storage --project demo-burmeselearner \"vitest run --dir tests\"",
    "audio": "NODE_USE_ENV_PROXY=1 TTS_PROVIDER=azure AZURE_SPEECH_REGION=uksouth node scripts/gen-audio.mjs"
  },
  "dependencies": {
    "@fontsource/noto-sans-myanmar": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "firebase": "^13.4.0",
    "idb-keyval": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ts-fsrs": "^6.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.1",
    "typescript": "^5.9.0",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1"
  }
}
