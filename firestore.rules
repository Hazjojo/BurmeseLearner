rules_version = '2';
// Single-user app: only the owner's account can read or write. Set OWNER_UID after first sign-in.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() { return request.auth != null && request.auth.uid == 'OWNER_UID'; }
    match /{document=**} { allow read, write: if isOwner(); }
  }
}
